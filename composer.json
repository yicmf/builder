{
    "name": "yicmf/builder",
    "description": "builder",
    "homepage": "https://gitee.com/yicmf/builder",
    "license": "Apache-2.0",
    "type": "think-extend",
    "authors": [
        {
            "name": "yicmf",
            "email": "yicmf@qq.com"
        }
